# Copy to .env.local (local) or set in your host's environment settings (production).
# NEVER commit real values. Items marked REQUIRED must be set before launch.

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Public contact details (shown on the site; leave blank/placeholder to hide) ──
NEXT_PUBLIC_PHONE="[PLACEHOLDER: phone]"
NEXT_PUBLIC_WHATSAPP="[PLACEHOLDER: whatsapp number in international format]"
NEXT_PUBLIC_EMAIL="[PLACEHOLDER: email]"
# Real profile URLs only. Leave empty to hide the icon.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ── Database (REQUIRED in production) ────────────────────
# PostgreSQL connection string, e.g. from Neon / Supabase / Railway / your own server.
# Local development without this variable uses an embedded Postgres (PGlite) in ./.data
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Security (REQUIRED in production) ────────────────────
# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ── Email (optional until configured; the site records "skipped" — never "sent" — without it) ──
# Provider: Resend (https://resend.com). Verify your sending domain first.
EMAIL_PROVIDER_API_KEY="[PLACEHOLDER: resend api key]"
EMAIL_FROM="[PLACEHOLDER: e.g. Care Team <no-reply@your-domain.com>]"
# Where admin alerts for new requests/messages are sent.
EMAIL_TO="[PLACEHOLDER: staff inbox]"

# ── Analytics / Search Console (optional) ────────────────
NEXT_PUBLIC_GA_ID="[PLACEHOLDER: G-XXXXXXXXXX]"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="[PLACEHOLDER: verification code]"
